# Public application URL
# In production/pilot this must be the real deployed SalonFlow URL because it is used in public booking and unsubscribe links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend provider for SalonFlow-managed email delivery
RESEND_API_KEY=
# During local testing this may be onboarding@resend.dev. In production use a verified SalonFlow SaaS sender domain.
SALONFLOW_EMAIL_FROM_ADDRESS=onboarding@resend.dev
# Optional fallback Reply-To. Tenant-specific Reply-To takes precedence when configured.
SALONFLOW_EMAIL_DEFAULT_REPLY_TO=
# Safety caps for SalonFlow-managed tenant email. Configure explicitly in production.
SALONFLOW_MANAGED_EMAIL_MONTHLY_LIMIT=100
SALONFLOW_MANAGED_EMAIL_GLOBAL_MONTHLY_LIMIT=500

# Legacy/system email compatibility (for example platform feedback notifications)
RESEND_FROM_EMAIL=SalonFlow <onboarding@resend.dev>
RESEND_REPLY_TO=

# Scheduled jobs
# Must match the secret used by the deployed Netlify scheduled functions when they call protected Next.js cron routes.
CRON_SECRET=

# Never add real production values to this file.
